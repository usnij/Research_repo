{
  "path": "",
  "experiment_name": "",
  "run_tag": "",
  "resume": "",
  "out_dir": "./runs",
  "n_iterations": 30000,
  "with_gui": false,
  "gui_update_from_device": true,
  "val_frequency": 999999,
  "num_workers": 0,
  "use_wandb": false,
  "wandb_project": "3dgrt",
  "test_last": true,
  "validate_first": false,
  "log_frequency": 1,
  "compute_extra_metrics": false,
  "enable_frame_timings": false,
  "enable_writer": false,
  "writer": {
    "hit_stat_frequency": 999999,
    "max_num_hits": 128,
    "log_image_views": [
      0,
      13,
      27,
      43,
      78
    ]
  },
  "export_ingp": {
    "enabled": false,
    "force_half": false,
    "path": ""
  },
  "import_ingp": {
    "enabled": false,
    "path": "",
    "init_global_step": 0
  },
  "export_ply": {
    "enabled": false,
    "path": ""
  },
  "import_ply": {
    "enabled": false,
    "path": "",
    "init_global_step": 0
  },
  "export_usdz": {
    "enabled": false,
    "path": "",
    "apply_normalizing_transform": true
  },
  "model": {
    "density_activation": "sigmoid",
    "scale_activation": "exp",
    "default_density": 0.5,
    "default_scale_factor": 0.1,
    "optimize_density": true,
    "optimize_features_albedo": true,
    "optimize_features_specular": true,
    "optimize_position": true,
    "optimize_rotation": true,
    "optimize_scale": true,
    "bvh_update_frequency": 1,
    "progressive_training": {
      "feature_type": "sh",
      "init_n_features": 0,
      "max_n_features": 3,
      "increase_frequency": 1000,
      "increase_step": 1
    },
    "background": {
      "name": "background-color",
      "color": "black"
    },
    "print_stats": false
  },
  "checkpoint": {
    "iterations": [
      7000,
      30000
    ]
  },
  "optimizer": {
    "type": "adam",
    "lr": 0.0,
    "eps": 1e-15,
    "params": {
      "positions": {
        "lr": 0.00016
      },
      "density": {
        "lr": 0.05
      },
      "features_albedo": {
        "lr": 0.0025
      },
      "features_specular": {
        "lr": 0.000125
      },
      "rotation": {
        "lr": 0.001
      },
      "scale": {
        "lr": 0.005
      },
      "a_raw": {
        "lr": 0.05
      }
    }
  },
  "scheduler": {
    "positions": {
      "type": "exp",
      "lr_init": 0.00016,
      "lr_final": 1.6e-06,
      "max_steps": 30000
    },
    "density": {
      "type": "skip"
    }
  },
  "loss": {
    "use_l1": true,
    "lambda_l1": 0.8,
    "use_l2": false,
    "lambda_l2": 1.0,
    "use_ssim": false,
    "lambda_ssim": 0.2,
    "use_opacity": true,
    "lambda_opacity": 0.01,
    "observed_only": false,
    "use_scale": true,
    "lambda_scale": 0.01
  },
  "strategy": {
    "method": "MCMCStrategy",
    "print_stats": false,
    "binom_n_max": 51,
    "opacity_threshold": 0.005,
    "relocate": {
      "start_iteration": 500,
      "end_iteration": 25000,
      "frequency": 100
    },
    "perturb": {
      "start_iteration": 0,
      "end_iteration": 27500,
      "frequency": 1,
      "noise_lr": 500000.0
    },
    "add": {
      "placement": "opacity",
      "start_iteration": 599,
      "end_iteration": 5001,
      "frequency": 100,
      "max_n_gaussians": 1229851
    },
    "diversity_loss": {
      "enabled": false,
      "lambda_val": 0.001,
      "start_iteration": 1000,
      "knn_frequency": 1000,
      "knn_end_iteration": 30000
    },
    "opacity_overlap_loss": {
      "enabled": false,
      "lambda_val": 0.001,
      "start_iteration": 1000
    }
  },
  "dataset": {
    "type": "colmap",
    "downsample_factor": 2,
    "test_split_interval": 8
  },
  "initialization": {
    "method": "colmap",
    "observation_scale_factor": 0.01,
    "use_observation_points": false
  },
  "render": {
    "method": "3dgrt",
    "pipeline_type": "reference",
    "backward_pipeline_type": "referenceBwd",
    "particle_kernel_degree": 4,
    "particle_kernel_density_clamping": true,
    "particle_kernel_min_response": 0.0113,
    "particle_kernel_min_alpha": 0.00392156862745098,
    "particle_kernel_max_alpha": 0.99,
    "particle_radiance_sph_degree": 3,
    "primitive_type": "instances",
    "min_transmittance": 0.001,
    "max_consecutive_bvh_update": 15,
    "enable_normals": false,
    "enable_hitcounts": true,
    "enable_kernel_timings": false,
    "splat": {
      "medium_v2": false
    }
  }
}
