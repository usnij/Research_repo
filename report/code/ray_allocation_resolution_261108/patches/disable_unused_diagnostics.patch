+// Process-wide opt-in. Keep the validated default and output tensor shapes.
+// The reference pipeline null-checks these three diagnostic pointers.
+inline bool sparseGrtCollectDiagnostics() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SPARSE_GRT_DISABLE_DIAGNOSTICS");
+        return !(value && std::string(value) == "1");
+    }();
+    return enabled;
+}
